# Virtual environment
.venv/

# Python cache
__pycache__/
*.pyc

# Environment variables
.env

# Generated artifacts (don’t push results)
artifacts/*.csv
artifacts/*.parquet
artifacts/*.json

# Data
data/*.csv

# keep artifacts folder, but ignore heavy raw outputs
artifacts/**/*.parquet
artifacts/**/*.pkl
artifacts/**/*.joblib

# allow images and readmes
!artifacts/**/*.png
!artifacts/**/*.jpg
!artifacts/**/*.jpeg
!artifacts/**/*.svg
!artifacts/**/README.md

# Local compiler binary
tectonic.exe

# Figures and tables not utilized in the paper
artifacts/figure3.png
artifacts/figure4.png
artifacts/figure5.png
artifacts/table_covid_regimes.png
artifacts/fig_covid_breach_magnitudes.png
artifacts/fig_covid_timeseries.png
